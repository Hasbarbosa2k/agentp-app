# Database - MongoDB Local (instalado e a funcionar)
MONGODB_URI=

# JWT Secrets (apenas para desenvolvimento)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT Expiration times
JWT_ACCESS_EXPIRES_IN=45m
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

AI_SERVER_URL=http://localhost:3001

UI_AGENT_URL=http://localhost:3002

# OpenAI Configuration (para funcionalidades de IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email Configuration (para password reset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=your-email@gmail.com

# SSH Debug Configuration
SSH_DEBUG_PASSWORD=
